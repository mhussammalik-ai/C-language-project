// ==========================================
// DELETE PATIENT
// ==========================================

void deletePatient(
    struct Patient patients[],
    int *count
)
{
    int id;

    int index;

    int i;


    if (*count == 0)
    {
        printf(
            "\nNo patient records available.\n"
        );

        return;
    }


    printf(
        "\nEnter Patient ID to delete: "
    );


    if (
        scanf(
            "%d",
            &id
        ) != 1
    )
    {
        printf(
            "Invalid Patient ID.\n"
        );

        clearInputBuffer();

        return;
    }


    index =
        findPatientRecursive(
            patients,
            *count,
            0,
            id
        );


    if (index == -1)
    {
        printf(
            "\nPatient record not found.\n"
        );

        return;
    }


    // Shift remaining patients.

    for (
        i = index;
        i < *count - 1;
        i++
    )
    {
        patients[i] =
            patients[i + 1];
    }


    // Decrease original patient count.

    (*count)--;


    printf(
        "\nPatient record deleted successfully!\n"
    );
}


// ==========================================
// SAVE REPORT TO TXT FILE
// ==========================================

void saveReport(
    struct Patient patients[],
    int count
)
{
    FILE *file;

    int i;


    if (count == 0)
    {
        printf(
            "\nNo patient records available to save.\n"
        );

        return;
    }


    // Create/open text file.

    file =
        fopen(
            "patient_report.txt",
            "w"
        );


    if (file == NULL)
    {
        printf(
            "\nError! Could not create the file.\n"
        );

        return;
    }


    fprintf(
        file,
        "=========================================\n"
    );

    fprintf(
        file,
        " PATIENT HEALTH RECORD MANAGEMENT SYSTEM\n"
    );

    fprintf(
        file,
        "=========================================\n\n"
    );


    // Save every patient.

    for (i = 0; i < count; i++)
    {
        fprintf(
            file,
            "Patient Number: %d\n",
            i + 1
        );

        fprintf(
            file,
            "Patient ID: %d\n",
            patients[i].id
        );

        fprintf(
            file,
            "Patient Name: %s\n",
            patients[i].name
        );

        fprintf(
            file,
            "Age: %d\n",
            patients[i].age
        );

        fprintf(
            file,
            "Temperature Visit 1: %.2f C\n",
            patients[i].temperature[0]
        );

        fprintf(
            file,
            "Temperature Visit 2: %.2f C\n",
            patients[i].temperature[1]
        );

        fprintf(
            file,
            "Temperature Visit 3: %.2f C\n",
            patients[i].temperature[2]
        );

        fprintf(
            file,
            "Average Temperature: %.2f C\n",
            patients[i].averageTemperature
        );

        fprintf(
            file,
            "-----------------------------------------\n"
        );
    }


    // Close the file.

    fclose(file);


    printf(
        "\nReport saved successfully!\n"
    );

    printf(
        "TXT File Created: patient_report.txt\n"
    );
}


// ==========================================
// LOAD REPORT FROM TXT FILE
// ==========================================

void loadReport()
{
    FILE *file;

    char character;


    // Open existing file for reading.

    file =
        fopen(
            "patient_report.txt",
            "r"
        );


    if (file == NULL)
    {
        printf(
            "\nNo saved report found!\n"
        );

        printf(
            "Please save a report first.\n"
        );

        return;
    }


    printf(
        "\n=========================================\n"
    );

    printf(
        "          SAVED PATIENT REPORT\n"
    );

    printf(
        "=========================================\n\n"
    );


    // Read file character by character.

    while (
        (character = fgetc(file)) != EOF
    )
    {
        printf(
            "%c",
            character
        );
    }


    // Close file.

    fclose(file);


    printf("\n");
}
