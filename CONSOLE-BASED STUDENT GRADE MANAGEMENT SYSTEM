// ==========================================
// CALCULATE AVERAGE TEMPERATURE
// ==========================================

float calculateAverage(float temperatures[])
{
    float total = 0;

    int i;

    /*
       Arrays are passed to functions as pointers
       in C. This allows the function to access
       the original temperature values.
    */

    for (i = 0; i < VISITS; i++)
    {
        total += temperatures[i];
    }

    return total / VISITS;
}


// ==========================================
// RECURSIVE SEARCH FUNCTION
// ==========================================

int findPatientRecursive(
    struct Patient patients[],
    int count,
    int index,
    int id
)
{
    // Base case:
    // All patients have been checked.

    if (index >= count)
    {
        return -1;
    }


    // Patient found.

    if (patients[index].id == id)
    {
        return index;
    }


    // Recursive call:
    // Search the next patient.

    return findPatientRecursive(
        patients,
        count,
        index + 1,
        id
    );
}


// ==========================================
// CHECK DUPLICATE PATIENT ID
// ==========================================

int isDuplicateID(
    struct Patient patients[],
    int count,
    int id
)
{
    int result;

    result = findPatientRecursive(
        patients,
        count,
        0,
        id
    );


    if (result != -1)
    {
        return 1;
    }

    return 0;
}


// ==========================================
// ADD PATIENT
// ==========================================

void addPatient(
    struct Patient patients[],
    int *count
)
{
    int i;


    // Check maximum capacity.

    if (*count >= MAX_PATIENTS)
    {
        printf(
            "\nMaximum limit of %d patients reached!\n",
            MAX_PATIENTS
        );

        return;
    }


    printf(
        "\n========== ADD PATIENT ==========\n"
    );


    // --------------------------------------
    // INPUT PATIENT ID
    // --------------------------------------

    do
    {
        printf("Enter Patient ID: ");

        if (scanf(
                "%d",
                &patients[*count].id
            ) != 1)
        {
            printf(
                "Invalid input! Please enter a number.\n"
            );

            clearInputBuffer();

            patients[*count].id = -1;

            continue;
        }


        if (patients[*count].id <= 0)
        {
            printf(
                "Patient ID must be greater than 0.\n"
            );
        }

        else if (
            isDuplicateID(
                patients,
                *count,
                patients[*count].id
            )
        )
        {
            printf(
                "This Patient ID already exists!\n"
            );
        }

    }
    while (
        patients[*count].id <= 0 ||
        isDuplicateID(
            patients,
            *count,
            patients[*count].id
        )
    );


    clearInputBuffer();


    // --------------------------------------
    // INPUT PATIENT NAME
    // --------------------------------------

    do
    {
        printf("Enter Patient Name: ");

        fgets(
            patients[*count].name,
            sizeof(
                patients[*count].name
            ),
            stdin
        );


        // Remove newline character.

        patients[*count].name[
            strcspn(
                patients[*count].name,
                "\n"
            )
        ] = '\0';


        if (
            strlen(
                patients[*count].name
            ) == 0
        )
        {
            printf(
                "Patient name cannot be empty.\n"
            );
        }

    }
    while (
        strlen(
            patients[*count].name
        ) == 0
    );


    // --------------------------------------
    // INPUT AGE
    // --------------------------------------

    do
    {
        printf("Enter Patient Age: ");

        if (
            scanf(
                "%d",
                &patients[*count].age
            ) != 1
        )
        {
            printf(
                "Invalid age! Please enter a number.\n"
            );

            clearInputBuffer();

            patients[*count].age = -1;

            continue;
        }


        if (
            patients[*count].age <= 0 ||
            patients[*count].age > 120
        )
        {
            printf(
                "Invalid age! Enter between 1 and 120.\n"
            );
        }

    }
    while (
        patients[*count].age <= 0 ||
        patients[*count].age > 120
    );


    // --------------------------------------
    // INPUT TEMPERATURES
    // --------------------------------------

    for (i = 0; i < VISITS; i++)
    {
        do
        {
            printf(
                "Enter Temperature for Visit %d (30-45 C): ",
                i + 1
            );


            if (
                scanf(
                    "%f",
                    &patients[*count].temperature[i]
                ) != 1
            )
            {
                printf(
                    "Invalid input! Please enter a number.\n"
                );

                clearInputBuffer();

                patients[*count].temperature[i] = -1;

                continue;
            }


            if (
                patients[*count].temperature[i] < 30.0 ||
                patients[*count].temperature[i] > 45.0
            )
            {
                printf(
                    "Invalid temperature! "
                    "Enter between 30 and 45 C.\n"
                );
            }

        }
        while (
            patients[*count].temperature[i] < 30.0 ||
            patients[*count].temperature[i] > 45.0
        );
    }


    // --------------------------------------
    // CALCULATE AVERAGE
    // --------------------------------------

    patients[*count].averageTemperature =
        calculateAverage(
            patients[*count].temperature
        );


    /*
       Pointer is used here.

       *count changes the original
       patientCount variable in main().
    */

    (*count)++;


    printf(
        "\nPatient record added successfully!\n"
    );
}


