// ==========================================
// SEARCH PATIENT
// ==========================================

void searchPatient(
    struct Patient patients[],
    int count
)
{
    int id;

    int index;


    if (count == 0)
    {
        printf(
            "\nNo patient records available.\n"
        );

        return;
    }


    printf(
        "\nEnter Patient ID to search: "
    );


    if (
        scanf(
            "%d",
            &id
        ) != 1
    )
    {
        printf(
            "Invalid Patient ID.\n"
        );

        clearInputBuffer();

        return;
    }


    // Call recursive search function.

    index =
        findPatientRecursive(
            patients,
            count,
            0,
            id
        );


    if (index == -1)
    {
        printf(
            "\nPatient record not found.\n"
        );
    }

    else
    {
        printf(
            "\nPatient Record Found!\n"
        );

        displaySinglePatient(
            patients[index]
        );
    }
}


