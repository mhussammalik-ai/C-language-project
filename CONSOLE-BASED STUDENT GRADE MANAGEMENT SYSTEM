#include <stdio.h>
#include <string.h>

#define MAX_PATIENTS 30
#define VISITS 3

// ==========================================
// STRUCTURE
// ==========================================

struct Patient
{
    int id;
    char name[50];
    int age;
    float temperature[VISITS];
    float averageTemperature;
};


// ==========================================
// FUNCTION PROTOTYPES
// ==========================================

void displayMenu();

void clearInputBuffer();

void addPatient(struct Patient patients[], int *count);

void displayPatients(struct Patient patients[], int count);

void displaySinglePatient(struct Patient patient);

void searchPatient(struct Patient patients[], int count);

void updatePatient(struct Patient patients[], int count);

void deletePatient(struct Patient patients[], int *count);

float calculateAverage(float temperatures[]);

int findPatientRecursive(
    struct Patient patients[],
    int count,
    int index,
    int id
);

int isDuplicateID(
    struct Patient patients[],
    int count,
    int id
);

void saveReport(
    struct Patient patients[],
    int count
);

void loadReport();


// ==========================================
// MAIN FUNCTION
// ==========================================

int main()
{
    struct Patient patients[MAX_PATIENTS];

    int patientCount = 0;
    int choice;

    do
    {
        displayMenu();

        printf("Enter your choice: ");

        if (scanf("%d", &choice) != 1)
        {
            printf("\nInvalid input! Please enter a number.\n");

            clearInputBuffer();

            continue;
        }

        switch (choice)
        {
            case 1:

                addPatient(
                    patients,
                    &patientCount
                );

                break;


            case 2:

                displayPatients(
                    patients,
                    patientCount
                );

                break;


            case 3:

                searchPatient(
                    patients,
                    patientCount
                );

                break;


            case 4:

                updatePatient(
                    patients,
                    patientCount
                );

                break;


            case 5:

                deletePatient(
                    patients,
                    &patientCount
                );

                break;


            case 6:

                saveReport(
                    patients,
                    patientCount
                );

                break;


            case 7:

                loadReport();

                break;


            case 8:

                printf("\nThank you for using the ");
                printf("Patient Health Record Management System.\n");

                break;


            default:

                printf("\nInvalid choice! Please try again.\n");
        }

    }
    while (choice != 8);


    return 0;
}


